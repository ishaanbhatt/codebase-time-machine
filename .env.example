# Optional locally. Recommended for higher GitHub API quotas in production.
GITHUB_TOKEN=

# Required in production. The analyze API fails closed without these values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional secret used to pseudonymize client addresses in limiter keys.
RATE_LIMIT_SALT=

# Canonical public origin used for metadata. Never use request Host headers.
SITE_URL=http://localhost:3000
